@startuml
class Auth {
}
class LoginModel <<partial>> {
    + Login : string <<get>> <<set>>
    + Password : string <<get>> <<set>>
}
class RegisterModel <<partial>> {
    + Login : string <<get>> <<set>>
    + Password : string <<get>> <<set>>
    + Email : string <<get>> <<set>>
    + Name : string <<get>> <<set>>
    + Surname : string <<get>> <<set>>
    + Patronymic : string? <<get>> <<set>>
}
Auth +-- LoginModel
Auth +-- RegisterModel
RegisterModel --> "DateOfBirth" DateOnly
@enduml
